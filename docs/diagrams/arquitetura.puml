@startuml arquitetura
!theme cerulean-outline
title Arquitetura do Sistema Longevus

package "Fontes de Dados" {
  [DATASUS — SIH/SUS\n(.dbc, AIH Reduzida)] as DATASUS #LightYellow
  [IBGE\n(Censo 2022 + malha municipal)] as IBGE #LightYellow
}

package "Pipeline ETL" {
  [Script Python\n(pysus + pandas + GeoPandas)] as ETL #LightBlue
}

package "Banco de Dados" {
  database "PostgreSQL + PostGIS\ncontainer local | Supabase" as DB #LightGreen
}

package "Backend" {
  [API Node.js\nFastify + cache in-memory] as API #LightSalmon
}

package "Frontend" {
  [React + Vite\nLeaflet + TanStack Query] as FE #Lavender
}

actor "Profissional\nde Saúde" as USER

DATASUS --> ETL : arquivos .dbc
IBGE --> ETL : população e geometrias
ETL --> DB : INSERT (dados transformados)
DB --> API : SQL agregado\n(taxa por 100 mil hab.)
API --> FE : JSON agregado + GeoJSON
FE --> USER : mapa coroplético interativo
USER --> FE : filtros (CID / sexo / faixa etária)

note bottom of DB
  Consultas espaciais sobre a
  topologia do território:
  vizinhança por contiguidade
  e autocorrelação local.
end note

@enduml
