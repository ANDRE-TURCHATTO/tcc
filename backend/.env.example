# Variáveis de ambiente — Longevus Backend
# Copie este arquivo para .env e preencha os valores reais

# Porta e host do servidor HTTP
PORT=3000
HOST=0.0.0.0

# --- Driver de banco ---
# A API acessa o banco por um de dois caminhos. DATABASE_URL tem precedência.
#
# 1) Postgres/PostGIS direto (ambiente local do docker-compose.yml na raiz).
#    É o modo em que as consultas espaciais e as medições de desempenho são
#    reprodutíveis.
DATABASE_URL=postgresql://longevus:longevus@localhost:5432/longevus
PG_POOL_MAX=10

# 2) Supabase (implantação em nuvem). Usado quando DATABASE_URL está ausente.
#    Credenciais em: Supabase > Project Settings > API
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=your_service_role_key

# Tempo de vida do cache in-memory, em segundos
CACHE_TTL_SECONDS=300

# Origens autorizadas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
